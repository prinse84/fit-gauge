{
  "schemaVersion": 1,
  "id": "prinse84.fit-gauge",
  "name": "Fit Gauge",
  "version": "0.2.0",
  "author": "prinse84",
  "description": "At-a-glance Fitbit stats in the Omarchy bar",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Fit Gauge",
    "description": "At-a-glance Fitbit stats in the Omarchy bar",
    "category": "Health",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "stepGoal": 11000,
      "azmGoal": 24,
      "calorieGoal": 2300,
      "distanceGoalMeters": 8851,
      "floorsGoal": 11,
      "ring1Metric": "Steps",
      "ring2Metric": "Active Zone Minutes",
      "ring3Metric": "Total Calories",
      "sedentaryNudge": "Off",
      "nudgeSedentaryMinutes": 45,
      "paceNudge": "Off",
      "paceNudgeMarginPercent": 20
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "stepGoal",
        "type": "integer",
        "label": "Step goal",
        "min": 1000,
        "max": 50000,
        "step": 500,
        "defaultValue": 11000
      },
      {
        "key": "azmGoal",
        "type": "integer",
        "label": "Active Zone Minutes goal",
        "min": 5,
        "max": 120,
        "step": 1,
        "defaultValue": 24
      },
      {
        "key": "calorieGoal",
        "type": "integer",
        "label": "Daily calorie goal (total burn)",
        "description": "Total daily calories burned - BMR/resting plus activity, matching the API's total-calories field. Default is USDA's gender-neutral moderately-active midpoint, not an active-only figure.",
        "min": 1000,
        "max": 6000,
        "step": 50,
        "defaultValue": 2300
      },
      {
        "key": "distanceGoalMeters",
        "type": "integer",
        "label": "Distance goal (meters)",
        "description": "5.5 mi ≈ 8851m. No non-integer settings type is available, so this is stored in meters and shown as miles in the popup.",
        "min": 500,
        "max": 50000,
        "step": 100,
        "defaultValue": 8851
      },
      {
        "key": "floorsGoal",
        "type": "integer",
        "label": "Floors goal",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 11
      },
      {
        "key": "ring1Metric",
        "type": "enum",
        "label": "Ring 1 metric (outer)",
        "options": ["Steps", "Active Zone Minutes", "Total Calories", "Distance", "Floors"],
        "defaultValue": "Steps"
      },
      {
        "key": "ring2Metric",
        "type": "enum",
        "label": "Ring 2 metric (middle)",
        "options": ["Steps", "Active Zone Minutes", "Total Calories", "Distance", "Floors"],
        "defaultValue": "Active Zone Minutes"
      },
      {
        "key": "ring3Metric",
        "type": "enum",
        "label": "Ring 3 metric (inner)",
        "options": ["Steps", "Active Zone Minutes", "Total Calories", "Distance", "Floors"],
        "defaultValue": "Total Calories"
      },
      {
        "key": "sedentaryNudge",
        "type": "enum",
        "label": "Stand-up nudge",
        "description": "Opt-in. Sends a desktop notification when you've been continuously active at the desk (not idle) for a while - independent of step count. Respects Do Not Disturb.",
        "options": ["Off", "On"],
        "defaultValue": "Off"
      },
      {
        "key": "nudgeSedentaryMinutes",
        "type": "integer",
        "label": "Stand-up nudge threshold (minutes)",
        "description": "How long you can be continuously active (not idle) before a stand-up nudge can fire.",
        "min": 15,
        "max": 180,
        "step": 5,
        "defaultValue": 45
      },
      {
        "key": "paceNudge",
        "type": "enum",
        "label": "Behind-pace nudge",
        "description": "Opt-in. Once a day, sends a notification if you're meaningfully behind a research-informed step pace for the time of day. Independent of the stand-up nudge. Respects Do Not Disturb.",
        "options": ["Off", "On"],
        "defaultValue": "Off"
      },
      {
        "key": "paceNudgeMarginPercent",
        "type": "integer",
        "label": "Behind-pace margin (%)",
        "description": "How far below expected pace (as a percent of the expected value) before the behind-pace nudge fires.",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 20
      }
    ]
  }
}
